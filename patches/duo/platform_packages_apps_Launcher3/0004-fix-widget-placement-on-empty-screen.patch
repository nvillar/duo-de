From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ethan <ethangoh98@gmail.com>
Date: Sat, 10 Oct 2026 08:43:02 +1100
Subject: [PATCH] Skip invalid IDs, check for valid context or exit early.

Change-Id: Ib1872234c960228cbe8ddac57b9089f6625975c2
---
 .../accessibility/LauncherAccessibilityDelegate.java       | 3 ++-
 src/com/android/launcher3/util/ActivityOptionsWrapper.java | 7 +++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/com/android/launcher3/accessibility/LauncherAccessibilityDelegate.java b/src/com/android/launcher3/accessibility/LauncherAccessibilityDelegate.java
index 094f792c65..9e037988c4 100644
--- a/src/com/android/launcher3/accessibility/LauncherAccessibilityDelegate.java
+++ b/src/com/android/launcher3/accessibility/LauncherAccessibilityDelegate.java
@@ -411,7 +411,8 @@ public class LauncherAccessibilityDelegate extends BaseAccessibilityDelegate<Lau
             screenIndex++;
         }
 
-        if (found) {
+        // Bypass sending empty screen ID
+        if (found && screenId > 0) {
             return screenId;
         }
 
diff --git a/src/com/android/launcher3/util/ActivityOptionsWrapper.java b/src/com/android/launcher3/util/ActivityOptionsWrapper.java
index 279390a00b..2d9fcbe7c1 100644
--- a/src/com/android/launcher3/util/ActivityOptionsWrapper.java
+++ b/src/com/android/launcher3/util/ActivityOptionsWrapper.java
@@ -42,6 +42,7 @@ public class ActivityOptionsWrapper {
     // Called when the app launch animation is complete
     public final RunnableList onEndCallback;
 
+    // Specifically for DUO-DE context grabbing applications.
     private Context context;
 
     public ActivityOptionsWrapper(ActivityOptions options, RunnableList onEndCallback) {
@@ -53,6 +54,12 @@ public class ActivityOptionsWrapper {
      * @see {@link ActivityOptions#toBundle()}
      */
     public Bundle toBundle() {
+        // We need to check if the context is null before we even consider doing an lookup contexts, 
+        // Not returning a bundle and blindly looking up context will cause issues, for widgets for example.
+        if(this.context == null){
+            return options.toBundle(); 
+        }
+
         String mode = "freeform";
         int windowMode;
         Boolean isTabletMode = ActivityContext.lookupContext(this.context).getDeviceProfile().getDeviceProperties().isTablet();
