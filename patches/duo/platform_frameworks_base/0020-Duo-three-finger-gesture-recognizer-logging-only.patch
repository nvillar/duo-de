+/**
+ * Logging-only prototype of the Surface Duo three-finger app gestures (span, contract, push).
+ *
+ * Watches every touch on the default display through a gesture input monitor and feeds it to
+ * {@link DuoThreeFingerClassifier}, which logs what it recognised under the tag {@code DuoGesture}. It never pilfers
+ * pointers and takes no action, so touch delivery to apps and other system gestures is unchanged.
+ *
+ * Off by default. Runs only on a Surface Duo with the two-panel window policy active
+ * ({@code sys.duode.panels.active=1}) and when {@code settings put global duode_three_finger_gestures 1};
+ * {@code duode_three_finger_gestures_config} overrides thresholds ("pinchDp=30,swipeDp=60"). Both settings apply
+ * without a restart. Touches that start on the keyguard are reported as cancelled with reason {@code keyguard}.
+ */
+@SysUISingleton
+public class DuoThreeFingerGestureMonitor implements CoreStartable {
+    static final String TAG = "DuoGesture";
+    static final String SETTING_ENABLED = "duode_three_finger_gestures";
+    static final String SETTING_CONFIG = "duode_three_finger_gestures_config";
+    static final String PROP_PANELS_ACTIVE = "sys.duode.panels.active";
+
+    private static final int MAX_POINTERS = 32;
+    private static final int RECENT = 20;
+
+    private final Context mContext;
+    private final Handler mMainHandler;
+    private final DisplayManager mDisplayManager;
+    private final GlobalSettings mGlobalSettings;
+    private final KeyguardStateController mKeyguardStateController;
+    private final DuoPanelGeometry.Spec mSpec = DuoPanelGeometry.forDevice(Build.DEVICE);
+
+    private final int[] mIds = new int[MAX_POINTERS];
+    private final float[] mXs = new float[MAX_POINTERS];
+    private final float[] mYs = new float[MAX_POINTERS];
+    private final Point mSize = new Point();
+    private final ArrayDeque<String> mRecent = new ArrayDeque<>();
+
+    private boolean mEnabled;
+    private boolean mPanelsActive;
+    private String mConfigSpec;
+    private String mConfigError;
+    private DuoThreeFingerClassifier.Config mConfig;
+    private DuoThreeFingerClassifier mClassifier;
+    private InputMonitorCompat mInputMonitor;
+    private InputChannelCompat.InputEventReceiver mInputEventReceiver;
+
+    @Inject
+    public DuoThreeFingerGestureMonitor(Context context, @Main Handler mainHandler,
+            DisplayManager displayManager, GlobalSettings globalSettings,
+            KeyguardStateController keyguardStateController) {
+        mContext = context;
+        mMainHandler = mainHandler;
+        mDisplayManager = displayManager;
+        mGlobalSettings = globalSettings;
+        mKeyguardStateController = keyguardStateController;
+    }
+
+    @Override
+    public void start() {
+        if (mSpec == null) return;  // not a Surface Duo
+        ContentObserver observer = new ContentObserver(mMainHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                update();
+            }
+        };
+        mGlobalSettings.registerContentObserverAsync(SETTING_ENABLED, observer);
+        mGlobalSettings.registerContentObserverAsync(SETTING_CONFIG, observer);
+        update();
+        Log.i(TAG, "ready on " + Build.DEVICE + ": panelsActive=" + mPanelsActive + " enabled=" + mEnabled
+                + " (settings put global " + SETTING_ENABLED + " 1)");
+    }
+
+    /** Main thread: applies the settings and the panel state. */
+    private void update() {
+        mPanelsActive = SystemProperties.getBoolean(PROP_PANELS_ACTIVE, false);
+        String spec = mGlobalSettings.getString(SETTING_CONFIG);
+        if (mConfig == null || !Objects.equals(spec, mConfigSpec)) {
+            mConfigSpec = spec;
+            mConfig = parseConfig(spec);
+            if (mClassifier != null) {
+                mClassifier.setConfig(mConfig);
+                Log.i(TAG, "config " + mConfig);
+            }
+        }
+        boolean enabled = mPanelsActive && mGlobalSettings.getInt(SETTING_ENABLED, 0) == 1;
+        if (enabled == mEnabled) return;
+        mEnabled = enabled;
+        if (enabled) {
+            mClassifier = new DuoThreeFingerClassifier(mConfig, this::displayAtTouchStart, this::onResult);
+            mInputMonitor = new InputMonitorCompat("duo-three-finger", Display.DEFAULT_DISPLAY);
+            mInputEventReceiver = mInputMonitor.getInputReceiver(Looper.getMainLooper(),
+                    Choreographer.getInstance(), this::onInputEvent);
+            Log.i(TAG, "enabled (logging only, no actions) config " + mConfig);
+        } else {
+            if (mInputEventReceiver != null) mInputEventReceiver.dispose();
+            if (mInputMonitor != null) mInputMonitor.dispose();
+            mInputEventReceiver = null;
+            mInputMonitor = null;
+            mClassifier = null;
+            Log.i(TAG, "disabled (panelsActive=" + mPanelsActive + ")");
+        }
+    }
+
+    private DuoThreeFingerClassifier.Config parseConfig(String spec) {
+        DuoThreeFingerClassifier.Config base = DuoThreeFingerClassifier.Config.forDensity(
+                mContext.getResources().getDisplayMetrics().density);
+        mConfigError = null;
+        if (TextUtils.isEmpty(spec)) return base;
+        try {
+            return DuoThreeFingerClassifier.Config.parse(spec, base);
+        } catch (IllegalArgumentException e) {
+            mConfigError = e.getMessage();
+            Log.w(TAG, "ignoring " + SETTING_CONFIG + "=\"" + spec + "\": " + e.getMessage());
+            return base;
+        }
+    }
+
+    private void onInputEvent(InputEvent ev) {
+        if (!(ev instanceof MotionEvent) || mClassifier == null) return;
+        MotionEvent event = (MotionEvent) ev;
+        if (!event.isFromSource(InputDevice.SOURCE_TOUCHSCREEN)) return;
+        int count = Math.min(event.getPointerCount(), MAX_POINTERS);
+        boolean onlyFingers = true;
+        for (int i = 0; i < count; i++) {
+            mIds[i] = event.getPointerId(i);
+            mXs[i] = event.getX(i);
+            mYs[i] = event.getY(i);
+            onlyFingers &= event.getToolType(i) == MotionEvent.TOOL_TYPE_FINGER;
+        }
+        mClassifier.onTouchEvent(event.getActionMasked(), event.getActionIndex(), event.getEventTime(), count,
+                mIds, mXs, mYs);
+        if (!onlyFingers) mClassifier.cancelTouch("non-finger", event.getEventTime());
+    }
+
+    /** Called at the first finger down of every touch. */
+    private DuoThreeFingerClassifier.DisplayState displayAtTouchStart() {
+        String blocked = mKeyguardStateController.isShowing() ? "keyguard" : null;
+        Display display = mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+        if (display == null) {
+            return DuoThreeFingerClassifier.DisplayState.of(mSpec, 0, 0, 0, "no-display");
+        }
+        display.getRealSize(mSize);
+        return DuoThreeFingerClassifier.DisplayState.of(mSpec, mSize.x, mSize.y, display.getRotation(), blocked);
+    }
+
+    private void onResult(DuoThreeFingerClassifier.Result result) {
+        String line = result.toLogString();
+        Log.i(TAG, line);
+        if (mRecent.size() == RECENT) mRecent.removeFirst();
+        mRecent.addLast(SystemClock.uptimeMillis() + " " + line);
+    }
+
+    @Override
+    public boolean isDumpCritical() {
+        return false;
+    }
+
+    @Override
+    public void dump(@NonNull PrintWriter pw, @NonNull String[] args) {
+        pw.println("DuoThreeFingerGestureMonitor (logging only):");
+        pw.println("  device=" + Build.DEVICE + " spec=" + (mSpec != null));
+        pw.println("  panelsActive=" + mPanelsActive + " enabled=" + mEnabled + " monitor="
+                + (mInputMonitor != null));
+        pw.println("  " + SETTING_CONFIG + "=" + mConfigSpec + (mConfigError != null ? " (ignored: "
+                + mConfigError + ")" : ""));
+        pw.println("  config " + mConfig);
+        pw.println("  recent results (uptime ms):");
+        for (String line : mRecent) pw.println("    " + line);
+    }
+}
