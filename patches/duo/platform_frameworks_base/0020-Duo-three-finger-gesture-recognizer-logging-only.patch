+            {1320, 900},  // 30 px from the hinge, panel 0
+            {1460, 900},  // 26 px from the hinge, panel 1
+            {40, 900},    // outer left edge
+            {2750, 900},  // outer right edge
+            {675, 50},    // status bar
+            {675, 1700},  // navigation area
