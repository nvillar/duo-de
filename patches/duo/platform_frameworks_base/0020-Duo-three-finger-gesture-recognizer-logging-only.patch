+package com.android.systemui.duo.gesture;
+
+import com.android.internal.policy.DuoPanelGeometry;
+
+import java.util.Locale;
+
+/**
+ * Recognises the Surface Duo three-finger app gestures in a touch stream. It only reports what it recognised; acting
+ * on it (span, contract, push) is left to the caller.
+ *
+ * <ul>
+ * <li>Pinch-out with the three fingers on one panel: {@link Gesture#SPAN} the app on that panel.</li>
+ * <li>Pinch-in with the three fingers on one panel: {@link Gesture#CONTRACT} onto that panel.</li>
+ * <li>Pinch with fingers starting on both panels: out = SPAN, in = CONTRACT; the target is the panel that holds two
+ * of the three fingers.</li>
+ * <li>Sideways swipe with the three fingers on one panel, toward the other panel: {@link Gesture#PUSH} the app
+ * over. "Sideways" means across the hinge, whatever the rotation.</li>
+ * </ul>
+ *
+ * Fingers are classified by the panel they first land on, and measured from where they landed; they may start
+ * moving while the others land (within {@link Config#landingMs} of the first), otherwise movement before the third
+ * finger makes the touch ineligible. The decision is taken once, when either the spread change
+ * reaches {@link Config#pinchDp} or the translation reaches {@link Config#swipeDp}: the winner must beat the other
+ * measure by a dead zone and every finger must agree with it, otherwise the gesture is cancelled. Contacts that land
+ * in the edge-swipe zones (outer edges, hinge-side edges, status bar, navigation area) make the touch ineligible.
+ * Contacts landing in the hinge band or on the display boundary (controller artefacts, fingers parked after sliding
+ * off an edge) are ignored. A finger that slides onto the display boundary counts as lifted.
+ *
+ * After recognition the gesture is followed until the first of the three fingers lifts: it commits if it is still at
+ * least {@link Config#commitFraction} of the threshold in the recognised direction, otherwise it is cancelled
+ * (reversed). One {@link Result} is reported at recognition and one at the end; touches that never had three
+ * counted fingers on the screen report nothing.
+ *
+ * Pure Java on top of {@link DuoPanelGeometry}, single threaded, no allocation per move event. The action constants
+ * have the values of {@code MotionEvent.ACTION_*}; coordinates are display pixels at the current rotation.
+ */
+public final class DuoThreeFingerClassifier {
+    public static final int ACTION_DOWN = 0;
+    public static final int ACTION_UP = 1;
+    public static final int ACTION_MOVE = 2;
+    public static final int ACTION_CANCEL = 3;
+    public static final int ACTION_POINTER_DOWN = 5;
+    public static final int ACTION_POINTER_UP = 6;
+
+    /** What a result reports. */
+    public enum Event { RECOGNIZED, COMMIT, CANCEL }
+
+    /** The command a gesture stands for. */
+    public enum Gesture { NONE, SPAN, CONTRACT, PUSH }
+
+    /** The finger motion. */
+    public enum Motion {
+        NONE("none"), PINCH_OUT("pinch-out"), PINCH_IN("pinch-in"), SWIPE("swipe");
+
+        public final String label;
+
+        Motion(String label) {
+            this.label = label;
+        }
+    }
+
+    /** Receives the results, on the thread that feeds the events. */
+    public interface Callback {
+        void onResult(Result result);
+    }
+
+    /** Describes the display when a touch starts (at ACTION_DOWN). */
+    public interface Environment {
+        DisplayState atTouchStart();
+    }
+
+    /** Thresholds, in dp unless noted. The classifier keeps a copy. */
+    public static final class Config {
+        /** Pixels per dp. */
+        public float density = 2.5f;
+        /** Edge-swipe zone along the outer (left/right) display edges, where Back starts. */
+        public float edgeDp = 24;
+        /** Edge zone along the panel edges next to the hinge. */
+        public float hingeDp = 24;
+        /** Edge zone along the display top (status bar, shade). */
+        public float topDp = 32;
+        /** Edge zone along the display bottom (navigation handle, taskbar). */
+        public float bottomDp = 48;
+        /** Contacts this close to the display boundary are artefacts or parked fingers. */
+        public float boundaryDp = 3;
+        /**
+         * Movement before the third finger lands that makes the touch something else (a scroll, a zoom), unless the
+         * third finger lands within {@link #landingMs} of the first.
+         */
+        public float slopDp = 12;
+        /** Milliseconds, from the first finger, within which the fingers may already move while landing. */
+        public float landingMs = 300;
+        /** Spread change that decides a pinch. */
+        public float pinchDp = 40;
+        /** Translation that decides a swipe. */
+        public float swipeDp = 80;
+        /** Dead zone on one panel: the winning score (distance / threshold) must be this many times the other. */
+        public float dominance = 2;
+        /** Across the panels: |pinch| must be at least this fraction of the translation across the hinge. */
+        public float crossDominance = 0.5f;
+        /** A push needs |across| >= sideways * |along|. */
+        public float sideways = 1;
+        /** A pinch finger may move against the pinch by at most this fraction of the pinch. */
+        public float pinchAgainst = 0.5f;
+        /** Each finger of a push must cover at least this fraction of the push. */
+        public float swipeFollow = 0.3f;
+        /** At the end, this fraction of the threshold must remain in the recognised direction to commit. */
+        public float commitFraction = 0.5f;
+
+        public Config() {
+        }
+
+        /** Defaults for a display density (DisplayMetrics.density). */
+        public static Config forDensity(float density) {
+            Config c = new Config();
+            c.density = density;
+            return c;
+        }
+
+        public Config copy() {
+            Config c = new Config();
+            for (String key : KEYS) c.set(key, get(key));
+            return c;
+        }
+
+        /**
+         * Applies "key=value,key=value" overrides (keys are the field names) to a copy of {@code base}. Whitespace
+         * and empty entries are ignored. Throws IllegalArgumentException for an unknown key or a bad value.
+         */
+        public static Config parse(String spec, Config base) {
+            Config c = base.copy();
+            if (spec == null) return c;
+            for (String entry : spec.split("[,;]")) {
+                entry = entry.trim();
+                if (entry.isEmpty()) continue;
+                int eq = entry.indexOf('=');
+                if (eq <= 0) throw new IllegalArgumentException("not key=value: " + entry);
+                String key = entry.substring(0, eq).trim();
+                float value;
+                try {
+                    value = Float.parseFloat(entry.substring(eq + 1).trim());
+                } catch (NumberFormatException e) {
+                    throw new IllegalArgumentException("bad value: " + entry);
+                }
+                if (Float.isNaN(value) || Float.isInfinite(value) || value < 0) {
+                    throw new IllegalArgumentException("bad value: " + entry);
+                }
+                c.set(key, value);
+            }
+            if (c.density <= 0 || c.pinchDp <= 0 || c.swipeDp <= 0) {
+                throw new IllegalArgumentException("density, pinchDp and swipeDp must be > 0");
+            }
+            return c;
+        }
+
+        static final String[] KEYS = {
+            "density", "edgeDp", "hingeDp", "topDp", "bottomDp", "boundaryDp", "slopDp", "landingMs", "pinchDp",
+            "swipeDp",
+            "dominance", "crossDominance", "sideways", "pinchAgainst", "swipeFollow", "commitFraction"};
+
+        float get(String key) {
+            switch (key) {
+                case "density": return density;
+                case "edgeDp": return edgeDp;
+                case "hingeDp": return hingeDp;
+                case "topDp": return topDp;
+                case "bottomDp": return bottomDp;
+                case "boundaryDp": return boundaryDp;
+                case "slopDp": return slopDp;
+                case "landingMs": return landingMs;
+                case "pinchDp": return pinchDp;
+                case "swipeDp": return swipeDp;
+                case "dominance": return dominance;
+                case "crossDominance": return crossDominance;
+                case "sideways": return sideways;
+                case "pinchAgainst": return pinchAgainst;
+                case "swipeFollow": return swipeFollow;
+                case "commitFraction": return commitFraction;
+                default: throw new IllegalArgumentException("unknown key: " + key);
+            }
+        }
+
+        void set(String key, float v) {
+            switch (key) {
+                case "density": density = v; break;
+                case "edgeDp": edgeDp = v; break;
+                case "hingeDp": hingeDp = v; break;
+                case "topDp": topDp = v; break;
+                case "bottomDp": bottomDp = v; break;
+                case "boundaryDp": boundaryDp = v; break;
+                case "slopDp": slopDp = v; break;
+                case "landingMs": landingMs = v; break;
+                case "pinchDp": pinchDp = v; break;
+                case "swipeDp": swipeDp = v; break;
+                case "dominance": dominance = v; break;
+                case "crossDominance": crossDominance = v; break;
+                case "sideways": sideways = v; break;
+                case "pinchAgainst": pinchAgainst = v; break;
+                case "swipeFollow": swipeFollow = v; break;
+                case "commitFraction": commitFraction = v; break;
+                default: throw new IllegalArgumentException("unknown key: " + key);
+            }
+        }
+
+        @Override
+        public String toString() {
+            StringBuilder sb = new StringBuilder();
+            for (String key : KEYS) {
+                if (sb.length() > 0) sb.append(',');
+                float v = get(key);
+                sb.append(key).append('=').append(v == (int) v ? Integer.toString((int) v) : Float.toString(v));
+            }
+            return sb.toString();
+        }
+    }
+
+    /** The display a touch happens on. */
+    public static final class DisplayState {
+        public final int width;
+        public final int height;
+        public final int rotation;
+        /** {panel 0, panel 1, hinge} as {@link DuoPanelGeometry#layout} returns them; null without two panels. */
+        public final int[][] layout;
+        /** Non-null: count fingers only, and report touches with three fingers as cancelled for this reason. */
+        public final String blockedReason;
+
+        private DisplayState(int width, int height, int rotation, int[][] layout, String blockedReason) {
+            this.width = width;
+            this.height = height;
+            this.rotation = rotation;
+            this.layout = layout;
+            this.blockedReason = blockedReason;
+        }
+
+        /**
+         * The state of a display of this size and rotation on a device with {@code spec}. Recognition needs both
+         * panels (spanned or gapless); a single panel or an unknown size blocks it.
+         */
+        public static DisplayState of(DuoPanelGeometry.Spec spec, int width, int height, int rotation,
+                String blockedReason) {
+            int mode = DuoPanelGeometry.mode(spec, width, height);
+            int[][] layout = null;
+            if (mode == DuoPanelGeometry.MODE_SPANNED || mode == DuoPanelGeometry.MODE_GAPLESS) {
+                layout = DuoPanelGeometry.layout(spec, width, height, rotation);
+            } else if (blockedReason == null) {
+                blockedReason = mode == DuoPanelGeometry.MODE_SINGLE ? "layout-single" : "layout-unknown";
+            }
+            return new DisplayState(width, height, rotation, layout, blockedReason);
+        }
+    }
+
+    /** One report. Distances are display pixels; "across" is along the axis from panel 0 to panel 1. */
+    public static final class Result {
+        public final Event event;
+        public final Gesture gesture;
+        public final Motion motion;
+        /** Fingers that landed on panel 0 and on panel 1. */
+        public final int onPanel0;
+        public final int onPanel1;
+        /** SPAN/CONTRACT: the panel the command is for. PUSH: the panel the app is pushed from. Otherwise -1. */
+        public final int target;
+        /** PUSH: the panel the app is pushed to. Otherwise -1. */
+        public final int to;
+        /** Spread change: mean distance from the centroid on one panel, half the group separation across. */
+        public final float pinchPx;
+        /** Spread ratio (now / at three fingers) on one panel, group separation ratio across the panels. */
+        public final float scale;
+        public final float acrossPx;
+        public final float alongPx;
+        /** Since the third finger landed, or since the first one when three were never tracked together. */
+        public final long durationMs;
+        public final int rotation;
+        public final String reason;
+
+        Result(Event event, Gesture gesture, Motion motion, int onPanel0, int onPanel1, int target, int to,
+                float pinchPx, float scale, float acrossPx, float alongPx, long durationMs, int rotation,
+                String reason) {
+            this.event = event;
+            this.gesture = gesture;
+            this.motion = motion;
+            this.onPanel0 = onPanel0;
+            this.onPanel1 = onPanel1;
+            this.target = target;
+            this.to = to;
+            this.pinchPx = pinchPx;
+            this.scale = scale;
+            this.acrossPx = acrossPx;
+            this.alongPx = alongPx;
+            this.durationMs = durationMs;
+            this.rotation = rotation;
+            this.reason = reason;
+        }
+
+        /** One line of key=value pairs, stable for log parsing. */
+        public String toLogString() {
+            return String.format(Locale.ROOT,
+                    "event=%s gesture=%s motion=%s split=%d+%d target=%d to=%d pinchPx=%+.0f scale=%.2f "
+                            + "acrossPx=%+.0f alongPx=%+.0f ms=%d rot=%d reason=%s",
+                    event, gesture, motion.label, onPanel0, onPanel1, target, to, pinchPx, scale, acrossPx,
+                    alongPx, durationMs, rotation, reason);
+        }
+
+        @Override
+        public String toString() {
+            return toLogString();
+        }
+    }
+
+    private static final int MAX_ID = 32;
+
+    private static final int IDLE = 0;        // no touch
+    private static final int COLLECTING = 1;  // fewer than three fingers so far
+    private static final int TRACKING = 2;    // three fingers: deciding, or following a recognised gesture
+    private static final int REJECTED = 3;    // ineligible; reported when the touch ends, if three fingers were down
+    private static final int DONE = 4;        // reported; ignore the rest of the touch
+
+    private final Environment mEnvironment;
+    private final Callback mCallback;
+    private Config mConfig;
+
+    // Thresholds in pixels, from mConfig, fixed for the duration of a touch.
+    private float mEdgePx, mHingePx, mTopPx, mBottomPx, mBoundaryPx, mSlopPx, mPinchPx, mSwipePx;
+
+    private int mState = IDLE;
+    private DisplayState mDisplay;
+    private String mPendingReason;
+    private long mFirstDownMs;
+    private long mLandingMs;   // when the first of the fingers now collecting landed
+    private boolean mMovedWhileLanding;
+    private long mThreeMs;
+    private int mCounted;      // counted fingers on the screen (not artefacts, not parked)
+    private int mMaxCounted;
+    private int mOn0, mOn1;    // landing panels of the counted fingers while collecting, then of the three
+    private final int[] mTrio = new int[3];
+    private float mUx = 1, mUy;  // unit axis from panel 0 to panel 1
+    private Motion mMotion;    // recognised motion, null while deciding
+    private int mSourcePanel;  // the panel of the three fingers, or the panel holding two of them
+
+    private final boolean[] mActive = new boolean[MAX_ID];   // counted and still tracked (not lifted, not parked)
+    private final int[] mPanel = new int[MAX_ID];
+    private final float[] mX0 = new float[MAX_ID];
+    private final float[] mY0 = new float[MAX_ID];
+    private final float[] mX = new float[MAX_ID];
+    private final float[] mY = new float[MAX_ID];
+    private final float[] mBx = new float[MAX_ID];
+    private final float[] mBy = new float[MAX_ID];
+    private final float[] mGroups = new float[8];  // per panel: x, y, start x, start y
+    private final int[] mGroupSize = new int[2];
+
+    // Metrics of the three fingers, from measure().
+    private float mPinch, mScale = 1, mAcross, mAlong;
+
+    public DuoThreeFingerClassifier(Config config, Environment environment, Callback callback) {
+        mEnvironment = environment;
+        mCallback = callback;
+        setConfig(config);
+    }
+
+    /** New thresholds; a touch in progress keeps the ones it started with. */
+    public void setConfig(Config config) {
+        mConfig = config.copy();
+        if (mState == IDLE) applyConfig();
+    }
+
+    public Config getConfig() {
+        return mConfig.copy();
+    }
+
+    private void applyConfig() {
+        float d = mConfig.density;
+        mEdgePx = mConfig.edgeDp * d;
+        mHingePx = mConfig.hingeDp * d;
+        mTopPx = mConfig.topDp * d;
+        mBottomPx = mConfig.bottomDp * d;
+        mBoundaryPx = mConfig.boundaryDp * d;
+        mSlopPx = mConfig.slopDp * d;
+        mPinchPx = mConfig.pinchDp * d;
+        mSwipePx = mConfig.swipeDp * d;
+    }
+
+    /**
+     * Feeds one motion event: the masked action, the index of the pointer that went down or up, the event time,
+     * and the id and position of each pointer (the first {@code count} entries of the arrays).
+     */
+    public void onTouchEvent(int action, int actionIndex, long timeMs, int count, int[] ids, float[] xs,
+            float[] ys) {
+        switch (action) {
+            case ACTION_DOWN:
+                reset();
+                startTouch(timeMs);
+                pointerDown(ids[actionIndex], xs[actionIndex], ys[actionIndex], timeMs);
+                break;
+            case ACTION_POINTER_DOWN:
+                if (mState == IDLE) return;  // the touch started before we were listening
+                updatePositions(count, ids, xs, ys, timeMs);
+                pointerDown(ids[actionIndex], xs[actionIndex], ys[actionIndex], timeMs);
+                break;
+            case ACTION_MOVE:
+                if (mState == IDLE) return;
+                updatePositions(count, ids, xs, ys, timeMs);
+                afterMove(timeMs);
+                break;
+            case ACTION_POINTER_UP:
+            case ACTION_UP:
+                if (mState == IDLE) return;
+                updatePositions(count, ids, xs, ys, timeMs);
+                pointerUp(ids[actionIndex], timeMs);
+                if (action == ACTION_UP) endTouch(timeMs);
+                break;
+            case ACTION_CANCEL:
+                if (mState == IDLE) return;
+                cancelTouch("input-cancelled", timeMs);
+                endTouch(timeMs);
+                break;
+            default:
+                break;
+        }
+    }
+
+    /**
+     * Gives up on the current touch for an external reason (for example a stylus joined it). A gesture in progress
+     * is reported as cancelled now; an undecided touch is reported when it ends, if it had three fingers.
+     */
+    public void cancelTouch(String reason, long timeMs) {
+        if (mState == TRACKING) {
+            measure();
+            report(Event.CANCEL, reason, timeMs);
+            mState = DONE;
+        } else if (mState == COLLECTING) {
+            reject(reason);
+        }
+    }
+
+    private void reset() {
+        mState = IDLE;
+        mDisplay = null;
+        mPendingReason = null;
+        mCounted = 0;
+        mMaxCounted = 0;
+        mOn0 = 0;
+        mOn1 = 0;
+        mMotion = null;
+        mSourcePanel = -1;
+        mPinch = 0;
+        mScale = 1;
+        mAcross = 0;
+        mAlong = 0;
+        for (int i = 0; i < MAX_ID; i++) mActive[i] = false;
+    }
+
+    private void startTouch(long timeMs) {
+        applyConfig();
+        mDisplay = mEnvironment.atTouchStart();
+        mFirstDownMs = timeMs;
+        mThreeMs = timeMs;
+        mState = COLLECTING;
+        if (mDisplay.blockedReason != null) reject(mDisplay.blockedReason);
+        int[][] l = mDisplay.layout;
+        if (l != null) {
+            float dx = (l[1][0] + l[1][2]) - (l[0][0] + l[0][2]);
+            float dy = (l[1][1] + l[1][3]) - (l[0][1] + l[0][3]);
+            float n = (float) Math.hypot(dx, dy);
+            mUx = n > 0 ? dx / n : 1;
+            mUy = n > 0 ? dy / n : 0;
+        }
+    }
+
+    private void endTouch(long timeMs) {
+        if (mMaxCounted >= 3) {
+            if (mState == REJECTED) {
+                report(Event.CANCEL, mPendingReason, timeMs);
+            } else if (mState == COLLECTING) {
+                report(Event.CANCEL, "no-decision", timeMs);
+            }
+        }
+        reset();
+    }
+
+    private void reject(String reason) {
+        if (mPendingReason == null) mPendingReason = reason;
+        mState = REJECTED;
+    }
+
+    private void pointerDown(int id, float x, float y, long timeMs) {
+        if (id < 0 || id >= MAX_ID || mState == DONE) return;
+        mX0[id] = mX[id] = x;
+        mY0[id] = mY[id] = y;
+        int[][] l = mDisplay.layout;
+        int panel = l == null ? -1 : DuoPanelGeometry.panelAt(l, (int) x, (int) y);
+        // Controller artefacts and parked fingers: on the hinge band or the display boundary.
+        if (onBoundary(x, y) || (l != null && panel < 0)) return;
+        // Brief contacts near the hinge while three fingers are down are artefacts too.
+        if (mState == TRACKING && inHingeZone(panel, x, y)) return;
+        mActive[id] = true;
+        mPanel[id] = panel;
+        mCounted++;
+        mMaxCounted = Math.max(mMaxCounted, mCounted);
+        if (mState == REJECTED) return;
+        if (mState == TRACKING) {
+            measure();
+            report(Event.CANCEL, "fourth-finger", timeMs);
+            mState = DONE;
+            return;
+        }
+        if (mCounted == 1) {
+            mLandingMs = timeMs;
+            mMovedWhileLanding = false;
+        }
+        if (panel == 0) mOn0++; else mOn1++;
+        if (inEdgeZone(panel, x, y)) {
+            reject("edge-start");
+        } else if (mCounted == 3) {
+            if (mMovedWhileLanding && timeMs - mLandingMs > mConfig.landingMs) {
+                reject("moved-before-three");
+            } else {
+                startTracking(timeMs);
+            }
+        }
+    }
+
+    private void updatePositions(int count, int[] ids, float[] xs, float[] ys, long timeMs) {
+        for (int i = 0; i < count; i++) {
+            int id = ids[i];
+            if (id < 0 || id >= MAX_ID || !mActive[id]) continue;
+            if (onBoundary(xs[i], ys[i])) {
+                fingerGone(id, timeMs, "parked");  // slid off an edge; keep its last position on the screen
+            } else {
+                mX[id] = xs[i];
+                mY[id] = ys[i];
+            }
+        }
+    }
+
+    private void pointerUp(int id, long timeMs) {
+        if (id >= 0 && id < MAX_ID && mActive[id]) fingerGone(id, timeMs, "lift");
+    }
+
+    private void fingerGone(int id, long timeMs, String how) {
+        mActive[id] = false;
+        mCounted--;
+        if (mState == COLLECTING) {
+            if (mPanel[id] == 0) mOn0--; else mOn1--;
+            return;
+        }
+        if (mState != TRACKING || !inTrio(id)) return;
+        measure();
+        if (mMotion != null) {
+            finish(how, timeMs);
+        } else if (!movedSinceTracking()) {
+            // A bouncing or hesitating finger: wait for three fingers again.
+            mState = COLLECTING;
+            if (mPanel[id] == 0) mOn0--; else mOn1--;
+        } else {
+            report(Event.CANCEL, "lifted-before-decision", timeMs);
+            mState = DONE;
+        }
+    }
+
+    private void afterMove(long timeMs) {
+        if (mState == COLLECTING) {
+            for (int id = 0; id < MAX_ID; id++) {
+                if (mActive[id] && Math.hypot(mX[id] - mX0[id], mY[id] - mY0[id]) > mSlopPx) {
+                    mMovedWhileLanding = true;
+                    break;
+                }
+            }
+            // Fingers may start moving while the others land; later, it is some other one or two finger touch.
+            if (mMovedWhileLanding && timeMs - mLandingMs > mConfig.landingMs) reject("moved-before-three");
+        } else if (mState == TRACKING && mMotion == null) {
+            measure();
+            decide(timeMs);
+        }
+    }
+
+    private void startTracking(long timeMs) {
+        int n = 0;
+        for (int id = 0; id < MAX_ID && n < 3; id++) {
+            if (mActive[id]) mTrio[n++] = id;
+        }
+        // Measure from where the fingers landed, so movement while the others were landing counts.
+        for (int id : mTrio) {
+            mBx[id] = mX0[id];
+            mBy[id] = mY0[id];
+        }
+        mThreeMs = timeMs;
+        mSourcePanel = mOn0 >= 2 ? 0 : 1;
+        mState = TRACKING;
+    }
+
+    private boolean inTrio(int id) {
+        return mTrio[0] == id || mTrio[1] == id || mTrio[2] == id;
+    }
+
+    private boolean across() {
+        return mOn0 > 0 && mOn1 > 0;
+    }
+
+    private boolean movedSinceTracking() {
+        for (int id : mTrio) {
+            if (Math.hypot(mX[id] - mBx[id], mY[id] - mBy[id]) > mSlopPx) return true;
+        }
+        return false;
+    }
+
+    /** Computes mPinch, mScale, mAcross and mAlong for the three fingers. */
+    private void measure() {
+        float tx, ty;
+        if (!across()) {
+            float cx = 0, cy = 0, bx = 0, by = 0;
+            for (int id : mTrio) {
+                cx += mX[id] / 3;
+                cy += mY[id] / 3;
+                bx += mBx[id] / 3;
+                by += mBy[id] / 3;
+            }
+            float r = 0, r0 = 0;
+            for (int id : mTrio) {
+                r += (float) Math.hypot(mX[id] - cx, mY[id] - cy) / 3;
+                r0 += (float) Math.hypot(mBx[id] - bx, mBy[id] - by) / 3;
+            }
+            mPinch = r - r0;
+            mScale = r0 > 0 ? r / r0 : 1;
+            tx = cx - bx;
+            ty = cy - by;
+        } else {
+            float[] g = mGroups;
+            for (int k = 0; k < 8; k++) g[k] = 0;
+            mGroupSize[0] = 0;
+            mGroupSize[1] = 0;
+            for (int id : mTrio) {
+                int p = mPanel[id];
+                mGroupSize[p]++;
+                g[4 * p] += mX[id];
+                g[4 * p + 1] += mY[id];
+                g[4 * p + 2] += mBx[id];
+                g[4 * p + 3] += mBy[id];
+            }
+            for (int p = 0; p < 2; p++) {
+                for (int k = 0; k < 4; k++) g[4 * p + k] /= mGroupSize[p];
+            }
+            float d0x = g[0] - g[2], d0y = g[1] - g[3];
+            float d1x = g[4] - g[6], d1y = g[5] - g[7];
+            mPinch = ((d1x - d0x) * mUx + (d1y - d0y) * mUy) / 2;
+            float sep0 = (g[6] - g[2]) * mUx + (g[7] - g[3]) * mUy;
+            float sep = (g[4] - g[0]) * mUx + (g[5] - g[1]) * mUy;
+            mScale = sep0 != 0 ? sep / sep0 : 1;
+            tx = (d0x + d1x) / 2;
+            ty = (d0y + d1y) / 2;
+        }
+        mAcross = tx * mUx + ty * mUy;
+        mAlong = -tx * mUy + ty * mUx;
+    }
+
+    private void decide(long timeMs) {
+        float pinchScore = Math.abs(mPinch) / mPinchPx;
+        float moveScore = (float) Math.hypot(mAcross, mAlong) / mSwipePx;
+        if (pinchScore < 1 && moveScore < 1) return;
+        Motion pinch = mPinch > 0 ? Motion.PINCH_OUT : Motion.PINCH_IN;
+        String cancel;
+        if (across()) {
+            if (pinchScore < 1) {
+                cancel = "swipe-split";
+            } else if (Math.abs(mPinch) < mConfig.crossDominance * Math.abs(mAcross)) {
+                cancel = "ambiguous";
+            } else if (!pinchAgrees()) {
+                cancel = "fingers-disagree";
+            } else {
+                recognize(pinch, timeMs);
+                return;
+            }
+        } else if (pinchScore >= mConfig.dominance * moveScore) {
+            if (!pinchAgrees()) {
+                cancel = "fingers-disagree";
+            } else {
+                recognize(pinch, timeMs);
+                return;
+            }
+        } else if (moveScore >= mConfig.dominance * pinchScore) {
+            if (Math.abs(mAcross) < mConfig.sideways * Math.abs(mAlong)) {
+                cancel = "not-sideways";
+            } else if (towardOtherPanel() <= 0) {
+                cancel = "away-from-other-panel";
+            } else if (!swipeAgrees()) {
+                cancel = "fingers-disagree";
+            } else {
+                recognize(Motion.SWIPE, timeMs);
+                return;
+            }
+        } else {
+            cancel = "ambiguous";
+        }
+        report(Event.CANCEL, cancel, timeMs);
+        mState = DONE;
+    }
+
+    /** Translation of a single panel touch toward the other panel. */
+    private float towardOtherPanel() {
+        return mSourcePanel == 0 ? mAcross : -mAcross;
+    }
+
+    private boolean pinchAgrees() {
+        float sign = Math.signum(mPinch);
+        float limit = -mConfig.pinchAgainst * Math.abs(mPinch);
+        if (!across()) {
+            float cx = 0, cy = 0, bx = 0, by = 0;
+            for (int id : mTrio) {
+                cx += mX[id] / 3;
+                cy += mY[id] / 3;
+                bx += mBx[id] / 3;
+                by += mBy[id] / 3;
+            }
+            for (int id : mTrio) {
+                float dr = (float) (Math.hypot(mX[id] - cx, mY[id] - cy) - Math.hypot(mBx[id] - bx, mBy[id] - by));
+                if (sign * dr < limit) return false;
+            }
+        } else {
+            for (int id : mTrio) {
+                float d = (mX[id] - mBx[id]) * mUx + (mY[id] - mBy[id]) * mUy;
+                float expected = (mPanel[id] == 1 ? 1 : -1) * sign;
+                if (expected * d < limit) return false;
+            }
+        }
+        return true;
+    }
+
+    private boolean swipeAgrees() {
+        float wx = mSourcePanel == 0 ? mUx : -mUx;
+        float wy = mSourcePanel == 0 ? mUy : -mUy;
+        float need = mConfig.swipeFollow * towardOtherPanel();
+        for (int id : mTrio) {
+            if ((mX[id] - mBx[id]) * wx + (mY[id] - mBy[id]) * wy < need) return false;
+        }
+        return true;
+    }
+
+    private void recognize(Motion motion, long timeMs) {
+        mMotion = motion;
+        report(Event.RECOGNIZED, motion == Motion.SWIPE ? "swipe" : "pinch", timeMs);
+    }
+
+    private void finish(String how, long timeMs) {
+        boolean commit;
+        if (mMotion == Motion.SWIPE) {
+            commit = towardOtherPanel() >= mConfig.commitFraction * mSwipePx;
+        } else {
+            float signed = mMotion == Motion.PINCH_OUT ? mPinch : -mPinch;
+            commit = signed >= mConfig.commitFraction * mPinchPx;
+        }
+        report(commit ? Event.COMMIT : Event.CANCEL, commit ? how : "reversed", timeMs);
+        mState = DONE;
+    }
+
+    private void report(Event event, String reason, long timeMs) {
+        Motion motion = mMotion != null ? mMotion : Motion.NONE;
+        Gesture gesture = Gesture.NONE;
+        int target = -1;
+        int to = -1;
+        if (motion == Motion.PINCH_OUT || motion == Motion.PINCH_IN) {
+            gesture = motion == Motion.PINCH_OUT ? Gesture.SPAN : Gesture.CONTRACT;
+            target = mSourcePanel;
+        } else if (motion == Motion.SWIPE) {
+            gesture = Gesture.PUSH;
+            target = mSourcePanel;
+            to = 1 - mSourcePanel;
+        }
+        boolean tracked = mState == TRACKING || mMotion != null;
+        long since = tracked ? mThreeMs : mFirstDownMs;
+        mCallback.onResult(new Result(event, gesture, motion, mOn0, mOn1, target, to,
+                tracked ? mPinch : 0, tracked ? mScale : 1, tracked ? mAcross : 0, tracked ? mAlong : 0,
+                timeMs - since, mDisplay.rotation, reason));
+    }
+
+    private boolean onBoundary(float x, float y) {
+        float b = mBoundaryPx;
+        return x < b || y < b || x > mDisplay.width - 1 - b || y > mDisplay.height - 1 - b;
+    }
+
+    /** Within the edge-swipe zone of its panel: outer edges, hinge-side edge, display top and bottom. */
+    private boolean inEdgeZone(int panel, float x, float y) {
+        int[][] l = mDisplay.layout;
+        if (l == null || panel < 0) return false;
+        int[] r = l[panel];
+        float left = r[0] <= 0 ? mEdgePx : mHingePx;
+        float right = r[2] >= mDisplay.width ? mEdgePx : mHingePx;
+        float top = r[1] <= 0 ? mTopPx : mHingePx;
+        float bottom = r[3] >= mDisplay.height ? mBottomPx : mHingePx;
+        return x - r[0] < left || r[2] - x < right || y - r[1] < top || r[3] - y < bottom;
+    }
+
+    /** Within the zone along the hinge-side edge of its panel. */
+    private boolean inHingeZone(int panel, float x, float y) {
+        int[][] l = mDisplay.layout;
+        if (l == null || panel < 0) return false;
+        int[] r = l[panel];
+        return (r[0] > 0 && x - r[0] < mHingePx) || (r[2] < mDisplay.width && r[2] - x < mHingePx)
+                || (r[1] > 0 && y - r[1] < mHingePx) || (r[3] < mDisplay.height && r[3] - y < mHingePx);
+    }
+}
