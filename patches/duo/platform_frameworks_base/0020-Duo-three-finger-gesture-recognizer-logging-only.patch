+                .down(0, 600, 800).moveAll(30, 1500, 0).upAll();
+        assertEquals(Collections.emptyList(), s.summary());
+    }
+
+    @Test
+    public void keyguardBlocksRecognition() {
+        TouchScript s = new TouchScript(DisplayState.of(TouchScript.DUO, 2784, 1800, 0, "keyguard"),
+                Config.forDensity(2.5f));
