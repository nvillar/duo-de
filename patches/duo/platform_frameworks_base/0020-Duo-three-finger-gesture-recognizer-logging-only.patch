+
+    @Test
+    public void aSinglePanelOrUnknownDisplayBlocksRecognition() {
+        TouchScript single = new TouchScript(DisplayState.of(TouchScript.DUO, 1350, 1800, 0, null),
+                Config.forDensity(2.5f));
+        three(single, P0[0], P0[1], 150).spread(20, 200).upAll();
+        assertEquals(list("CANCEL NONE layout-single"), single.summary());
+        TouchScript unknown = new TouchScript(DisplayState.of(TouchScript.DUO, 1080, 1920, 0, null),
+                Config.forDensity(2.5f));
+        three(unknown, 540, 900, 150).spread(20, 200).upAll();
+        assertEquals(list("CANCEL NONE layout-unknown"), unknown.summary());
+        TouchScript notDuo = new TouchScript(DisplayState.of(null, 2784, 1800, 0, null), Config.forDensity(2.5f));
+        three(notDuo, P0[0], P0[1], 150).spread(20, 200).upAll();
+        assertEquals(list("CANCEL NONE layout-unknown"), notDuo.summary());
+    }
+
+    @Test
+    public void gaplessDisplayWorks() {
+        TouchScript s = new TouchScript(DisplayState.of(TouchScript.DUO, 2700, 1800, 0, null),
+                Config.forDensity(2.5f));
+        three(s, 2025, 900, 150).moveAll(20, -400, 0).upAll();
+        assertEquals(list("RECOGNIZED PUSH 1>0 swipe", "COMMIT PUSH 1>0 lift"), s.summary());
+    }
+
+    @Test
+    public void otherRotationsUseTheAxisAcrossTheHinge() {
+        for (int rot = 1; rot < 4; rot++) {
+            // Pinch-out on panel 0, given in natural coordinates.
+            TouchScript pinch = new TouchScript(TouchScript.rotated(rot), Config.forDensity(2.5f));
+            downRotated(pinch, rot, P0[0], P0[1], 150);
+            pinch.spread(20, 200).upAll();
+            assertEquals("rot " + rot, list("RECOGNIZED SPAN 0 pinch", "COMMIT SPAN 0 lift"), pinch.summary());
+            assertEquals(rot, pinch.results.get(0).rotation);
+
+            // Push from panel 0 toward panel 1: +x in natural coordinates.
+            TouchScript push = new TouchScript(TouchScript.rotated(rot), Config.forDensity(2.5f));
+            downRotated(push, rot, P0[0], P0[1], 150);
+            float[] d = rotatedDelta(rot, 400, 0);
+            push.moveAll(20, d[0], d[1]).upAll();
+            assertEquals("rot " + rot, list("RECOGNIZED PUSH 0>1 swipe", "COMMIT PUSH 0>1 lift"), push.summary());
+            assertTrue(push.results.get(0).acrossPx > 150);
+
+            // Along the hinge is not sideways.
+            TouchScript along = new TouchScript(TouchScript.rotated(rot), Config.forDensity(2.5f));
+            downRotated(along, rot, P1[0], P1[1], 150);
+            float[] v = rotatedDelta(rot, 0, 300);
+            along.moveAll(20, v[0], v[1]).upAll();
+            assertEquals("rot " + rot, list("CANCEL NONE not-sideways"), along.summary());
+        }
+    }
+
+    private static void downRotated(TouchScript s, int rot, float cx, float cy, float r) {
+        float[][] pts = {{cx, cy - r}, {cx - 0.866f * r, cy + 0.5f * r}, {cx + 0.866f * r, cy + 0.5f * r}};
+        for (int i = 0; i < 3; i++) {
+            float[] p = TouchScript.rotate(pts[i][0], pts[i][1], rot);
+            s.down(i, p[0], p[1]);
+        }
+    }
+
+    private static float[] rotatedDelta(int rot, float dx, float dy) {
+        float[] a = TouchScript.rotate(1000, 900, rot);
+        float[] b = TouchScript.rotate(1000 + dx, 900 + dy, rot);
+        return new float[] {b[0] - a[0], b[1] - a[1]};
+    }
+
+    @Test
