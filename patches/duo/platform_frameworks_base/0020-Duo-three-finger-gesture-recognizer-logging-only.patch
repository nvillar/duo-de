+/**
+ * Host tests for {@link DuoThreeFingerClassifier} on synthetic touch streams. Duo 1 spanned display, rotation 0:
+ * panel 0 is x [0, 1350), the hinge band [1350, 1434), panel 1 [1434, 2784); 2.5 px/dp, so the default thresholds
+ * are a 100 px pinch, a 200 px swipe, 60 px side and hinge zones, 80 px top and 120 px bottom zones.
+ */
+@RunWith(JUnit4.class)
+public class DuoThreeFingerClassifierTest {
+    private static final float[] P0 = {675, 900};   // centre of panel 0
+    private static final float[] P1 = {2109, 900};  // centre of panel 1
+
+    /** Three fingers in a triangle of radius {@code r} around (cx, cy), ids 0, 1, 2. */
+    private static TouchScript three(TouchScript s, float cx, float cy, float r) {
+        return s.down(0, cx, cy - r)
+                .down(1, cx - 0.866f * r, cy + 0.5f * r)
+                .down(2, cx + 0.866f * r, cy + 0.5f * r);
+    }
+
+    private static List<String> list(String... s) {
+        return Arrays.asList(s);
+    }
+
+    @Test
+    public void pinchOutOnPanel0SpansThatPanel() {
+        TouchScript s = three(new TouchScript(), P0[0], P0[1], 150).hold(3).spread(20, 200).upAll();
+        assertEquals(list("RECOGNIZED SPAN 0 pinch", "COMMIT SPAN 0 lift"), s.summary());
+        Result r = s.results.get(0);
+        assertEquals(3, r.onPanel0);
+        assertEquals(0, r.onPanel1);
+        assertTrue(r.pinchPx >= 100 && r.pinchPx < 120);
+        assertTrue(r.scale > 1.6f);
+        assertTrue(Math.abs(r.acrossPx) < 5 && Math.abs(r.alongPx) < 5);
+    }
+
+    @Test
+    public void pinchInOnPanel1ContractsOntoThatPanel() {
+        TouchScript s = three(new TouchScript(), P1[0], P1[1], 250).spread(20, -200).upAll();
+        assertEquals(list("RECOGNIZED CONTRACT 1 pinch", "COMMIT CONTRACT 1 lift"), s.summary());
+        assertEquals(0, s.results.get(0).onPanel0);
+        assertEquals(3, s.results.get(0).onPanel1);
+    }
+
+    @Test
+    public void pinchOutAcrossThePanelsSpansTheMajorityPanel() {
+        TouchScript s = new TouchScript().down(0, 1000, 700).down(1, 1000, 1100).down(2, 1700, 900)
+                .move(20, 0, -200, 0, 1, -200, 0, 2, 200, 0).upAll();
+        assertEquals(list("RECOGNIZED SPAN 0 pinch", "COMMIT SPAN 0 lift"), s.summary());
+        Result r = s.results.get(0);
+        assertEquals(2, r.onPanel0);
+        assertEquals(1, r.onPanel1);
+        assertTrue(r.scale > 1);
+    }
+
+    @Test
+    public void pinchInAcrossThePanelsContractsOntoThePanelWithTwoFingers() {
+        TouchScript s = new TouchScript().down(0, 900, 900).down(1, 1800, 700).down(2, 1800, 1100)
+                .move(20, 0, 250, 0, 1, -250, 0, 2, -250, 0).upAll();
+        assertEquals(list("RECOGNIZED CONTRACT 1 pinch", "COMMIT CONTRACT 1 lift"), s.summary());
+        assertTrue(s.results.get(0).scale < 1);
+    }
+
+    @Test
+    public void pinchAcrossWithAnAnchoredThumbIsStillAPinch() {
