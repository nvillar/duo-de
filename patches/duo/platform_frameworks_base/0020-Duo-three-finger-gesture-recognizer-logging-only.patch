+    @Test
+    public void configParsesOverrides() {
+        Config base = Config.forDensity(2.5f);
+        Config c = Config.parse(" pinchDp=30, swipeDp = 100;dominance=3,, ", base);
+        assertEquals(30, c.pinchDp, 0);
+        assertEquals(100, c.swipeDp, 0);
+        assertEquals(3, c.dominance, 0);
+        assertEquals(2.5f, c.density, 0);
+        assertEquals(40, base.pinchDp, 0);  // base untouched
+        assertEquals(c.toString(), Config.parse(c.toString(), new Config()).toString());
+        assertEquals(base.toString(), Config.parse(null, base).toString());
+        for (String bad : new String[] {"nope=1", "pinchDp", "pinchDp=x", "pinchDp=-1", "pinchDp=0", "=3"}) {
+            try {
+                Config.parse(bad, base);
+                fail(bad);
+            } catch (IllegalArgumentException expected) {
+                // expected
+            }
+        }
+    }
+
+    @Test
+    public void configChangesApplyFromTheNextTouch() {
+        TouchScript s = new TouchScript();
+        three(s, P0[0], P0[1], 150);
+        s.classifier.setConfig(Config.parse("pinchDp=200", Config.forDensity(2.5f)));
+        s.spread(20, 200).upAll();  // still the 100 px threshold
+        three(s, P0[0], P0[1], 150).spread(20, 200).upAll();  // 500 px now: no decision before the lift
+        assertEquals(list("RECOGNIZED SPAN 0 pinch", "COMMIT SPAN 0 lift", "CANCEL NONE lifted-before-decision"),
+                s.summary());
+    }
+}
