+package com.android.systemui.duo.gesture;
+
+import com.android.internal.policy.DuoPanelGeometry;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.TreeMap;
+
+/**
+ * Synthetic touch streams for {@link DuoThreeFingerClassifier}, shaped like Android's: pointers ordered by id, one
+ * ACTION_(POINTER_)DOWN/UP per pointer, a MOVE with every pointer per 10 ms frame.
+ */
+final class TouchScript {
+    static final DuoPanelGeometry.Spec DUO = DuoPanelGeometry.DUO;
+
+    final List<DuoThreeFingerClassifier.Result> results = new ArrayList<>();
+    final DuoThreeFingerClassifier classifier;
+    private final TreeMap<Integer, float[]> mPointers = new TreeMap<>();
+    private DuoThreeFingerClassifier.DisplayState mDisplay;
+    private long mTime = 1000;
+
+    TouchScript() {
+        this(DuoThreeFingerClassifier.DisplayState.of(DUO, 2784, 1800, 0, null),
+                DuoThreeFingerClassifier.Config.forDensity(2.5f));
+    }
+
+    TouchScript(DuoThreeFingerClassifier.DisplayState display, DuoThreeFingerClassifier.Config config) {
+        mDisplay = display;
+        classifier = new DuoThreeFingerClassifier(config, () -> mDisplay, results::add);
+    }
+
+    /** A display state for a rotation of the spanned Duo display. */
+    static DuoThreeFingerClassifier.DisplayState rotated(int rotation) {
+        boolean portrait = (rotation & 1) == 1;
+        return DuoThreeFingerClassifier.DisplayState.of(DUO, portrait ? 1800 : 2784, portrait ? 2784 : 1800,
+                rotation, null);
+    }
+
+    void setDisplay(DuoThreeFingerClassifier.DisplayState display) {
+        mDisplay = display;
+    }
+
+    /** Maps a point given in the natural (rotation 0, 2784 x 1800) display to the display at {@code rotation}. */
+    static float[] rotate(float x, float y, int rotation) {
+        float w = 2784, h = 1800;
+        switch (rotation & 3) {
+            case 1: return new float[] {y, w - x};
+            case 2: return new float[] {w - x, h - y};
+            case 3: return new float[] {h - y, x};
+            default: return new float[] {x, y};
+        }
+    }
+
+    TouchScript down(int id, float x, float y) {
+        mTime += 10;
+        mPointers.put(id, new float[] {x, y});
+        int action = mPointers.size() == 1 ? DuoThreeFingerClassifier.ACTION_DOWN
+                : DuoThreeFingerClassifier.ACTION_POINTER_DOWN;
+        send(action, indexOf(id));
+        return this;
+    }
+
+    TouchScript up(int id) {
+        mTime += 10;
+        int action = mPointers.size() == 1 ? DuoThreeFingerClassifier.ACTION_UP
+                : DuoThreeFingerClassifier.ACTION_POINTER_UP;
+        send(action, indexOf(id));
+        mPointers.remove(id);
+        return this;
+    }
+
+    TouchScript upAll() {
+        while (!mPointers.isEmpty()) up(mPointers.firstKey());
+        return this;
+    }
+
+    TouchScript cancel() {
+        mTime += 10;
+        send(DuoThreeFingerClassifier.ACTION_CANCEL, 0);
+        mPointers.clear();
+        return this;
+    }
+
+    TouchScript hold(int frames) {
+        for (int i = 0; i < frames; i++) {
+            mTime += 10;
+            send(DuoThreeFingerClassifier.ACTION_MOVE, 0);
+        }
+        return this;
+    }
+
+    /**
+     * Moves pointers by the given offsets over {@code frames} frames: {@code moves} holds (id, dx, dy) triples.
+     * Pointers not named stay put.
+     */
+    TouchScript move(int frames, float... moves) {
+        float[][] start = new float[moves.length / 3][];
+        for (int k = 0; k < moves.length; k += 3) start[k / 3] = mPointers.get((int) moves[k]).clone();
+        for (int f = 1; f <= frames; f++) {
+            for (int k = 0; k < moves.length; k += 3) {
+                float[] p = mPointers.get((int) moves[k]);
+                p[0] = start[k / 3][0] + moves[k + 1] * f / frames;
+                p[1] = start[k / 3][1] + moves[k + 2] * f / frames;
+            }
+            mTime += 10;
+            send(DuoThreeFingerClassifier.ACTION_MOVE, 0);
+        }
+        return this;
+    }
+
+    /** Moves every pointer by (dx, dy) over {@code frames} frames. */
+    TouchScript moveAll(int frames, float dx, float dy) {
+        float[] m = new float[mPointers.size() * 3];
+        int k = 0;
+        for (int id : mPointers.keySet()) {
+            m[k++] = id;
+            m[k++] = dx;
+            m[k++] = dy;
+        }
+        return move(frames, m);
+    }
+
+    /**
+     * Moves the given pointers (all when none is given) radially from their centroid by {@code d} pixels
+     * (negative: inward).
+     */
+    TouchScript spread(int frames, float d, int... only) {
+        List<Integer> ids = new ArrayList<>();
+        if (only.length == 0) {
+            ids.addAll(mPointers.keySet());
+        } else {
+            for (int id : only) ids.add(id);
+        }
+        float cx = 0, cy = 0;
+        for (int id : ids) {
+            cx += mPointers.get(id)[0] / ids.size();
+            cy += mPointers.get(id)[1] / ids.size();
+        }
+        float[] m = new float[ids.size() * 3];
+        int k = 0;
+        for (int id : ids) {
+            float[] p = mPointers.get(id);
+            float len = (float) Math.hypot(p[0] - cx, p[1] - cy);
+            m[k++] = id;
+            m[k++] = d * (p[0] - cx) / len;
+            m[k++] = d * (p[1] - cy) / len;
+        }
+        return move(frames, m);
+    }
+
+    private int indexOf(int id) {
+        return mPointers.headMap(id).size();
+    }
+
+    private void send(int action, int actionIndex) {
+        int n = mPointers.size();
+        int[] ids = new int[n];
+        float[] xs = new float[n];
+        float[] ys = new float[n];
+        int i = 0;
+        for (int id : mPointers.keySet()) {
+            ids[i] = id;
+            xs[i] = mPointers.get(id)[0];
+            ys[i] = mPointers.get(id)[1];
+            i++;
+        }
+        classifier.onTouchEvent(action, actionIndex, mTime, n, ids, xs, ys);
+    }
+
+    long time() {
+        return mTime;
+    }
+
+    /** The results as "EVENT GESTURE target>to reason" strings, for compact assertions. */
+    List<String> summary() {
+        List<String> out = new ArrayList<>();
+        for (DuoThreeFingerClassifier.Result r : results) {
+            String t = r.gesture == DuoThreeFingerClassifier.Gesture.NONE ? ""
+                    : " " + r.target + (r.to >= 0 ? ">" + r.to : "");
+            out.add(r.event + " " + r.gesture + t + " " + r.reason);
+        }
+        return out;
+    }
+}
