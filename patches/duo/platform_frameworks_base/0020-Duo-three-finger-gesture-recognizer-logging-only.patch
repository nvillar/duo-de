+        assertEquals(list("RECOGNIZED SPAN 0 pinch", "COMMIT SPAN 0 lift"), s.summary());
+    }
+
+    @Test
+    public void liftingBeforeADecisionCancels() {
+        TouchScript s = three(new TouchScript(), P0[0], P0[1], 150).spread(5, 60).up(1).upAll();
+        assertEquals(list("CANCEL NONE lifted-before-decision"), s.summary());
+    }
+
+    @Test
+    public void aThreeFingerTapIsNoDecision() {
