+    /**
+     * Duo two panel policy. A tap on an editor in the window of the other panel moves window focus on its down; when
+     * the focus event reaches the app before the up, the window reports the focus gain with no focused editor, and
+     * the system answers (soft input state unspecified, no editor: HIDE_UNSPECIFIED_WINDOW) with a hide that it sends
+     * asynchronously. The up then focuses the editor, which asks for the keyboard and gets it; the hide, computed for
+     * the window's state at the focus gain, arrived afterwards and took the keyboard away. The system now sends hides
+     * computed for a window focus gain tagged with that window ({@code setImeHiddenOnWindowFocusGain}); such a hide is
+     * stale, and dropped, if the same window made a served show request after it last reported a window focus gain.
+     * Called on the view's thread just before the hide would be applied, where that window's show requests are made,
+     * so a request made before the hide runs is always seen.
+     */
+    private boolean isDuoWindowFocusHideStale(@NonNull ViewRootImpl root) {
+        synchronized (mH) {
+            final long[] seqs = mDuoImeSeqs.get(root);
+            return seqs != null && seqs[1] > seqs[0];
+        }
+    }
+
+    /** Records a window focus gain report ({@code which} 0) or a served show request (1) of {@code root}. */
+    @GuardedBy("mH")
+    private void noteDuoImeSeqLocked(@Nullable ViewRootImpl root, int which) {
+        if (root == null) {
+            return;
+        }
+        long[] seqs = mDuoImeSeqs.get(root);
+        if (seqs == null) {
+            seqs = new long[2];
+            mDuoImeSeqs.put(root, seqs);
+        }
+        seqs[which] = ++mDuoImeSeq;
+    }
