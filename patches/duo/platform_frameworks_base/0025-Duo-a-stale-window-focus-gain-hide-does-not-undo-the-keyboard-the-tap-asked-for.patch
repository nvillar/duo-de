+    /**
+     * Duo two panel policy. A tap on an editor in the window of the other panel moves window focus on its down; when
+     * the focus event reaches the app before the up, the window reports the focus gain with no focused editor, and
+     * the system answers (soft input state unspecified, no editor: HIDE_UNSPECIFIED_WINDOW) with a hide that it sends
+     * asynchronously. The up then focuses the editor, which asks for the keyboard and gets it; the hide, computed for
+     * the window's state at the focus gain, arrived afterwards and took the keyboard away. While the two panel policy
+     * is active the system sends hides computed for a window focus gain tagged with the window and with the start
+     * input sequence number of the report they answer ({@code setImeHiddenOnWindowFocusGain}). Such a hide:
+     * <ul>
+     * <li>applies only to the root that made that report, and only while that root is still the current one and
+     * still has that window: a response for a window that has lost input focus since is obsolete and dropped, never
+     * applied to another window;</li>
+     * <li>is stale, and dropped, if that root made a served show request after that report (checked on the view's
+     * thread right before the hide would be applied, where the root's show requests are made);</li>
+     * <li>is applied as before otherwise.</li>
+     * </ul>
+     * Both report paths record their report before the response can be handled (under {@code mH}). A report that is
+     * no longer recorded (the bounded record dropped it after many newer reports) is obsolete too and dropped.
+     */
+    @GuardedBy("mH")
+    private void handleDuoWindowFocusHideLocked(@Nullable ImeTracker.Token statsToken,
+            @Nullable IBinder windowToken, int startInputSeq) {
+        final DuoFocusReport report = mDuoFocusReports.remove(startInputSeq);
+        final ViewRootImpl root = report != null ? report.mRoot.get() : null;
+        final View rootView = root != null ? root.getView() : null;
+        if (root == null || root != mCurRootView || rootView == null
+                || rootView.getWindowToken() != windowToken) {
+            Log.i(TAG, "Duo: dropping the window focus gain hide for report " + startInputSeq
+                    + ": its window no longer has input focus");
+            ImeTracker.forLogging().onCancelled(statsToken,
+                    ImeTracker.PHASE_CLIENT_HANDLE_SET_IME_VISIBILITY);
+            return;
+        }
+        ImeTracker.forLogging().onProgress(statsToken,
+                ImeTracker.PHASE_CLIENT_HANDLE_SET_IME_VISIBILITY);
+        final long reportOrder = report.mOrder;
+        setImeVisibilityOnInsetsController(root, false /* visible */, statsToken,
+                () -> isDuoWindowFocusHideStale(root, reportOrder));
+    }
+
+    /** Whether {@code root} made a served show request after its focus report of local order {@code reportOrder}. */
+    private boolean isDuoWindowFocusHideStale(@NonNull ViewRootImpl root, long reportOrder) {
+        synchronized (mH) {
+            final Long show = mDuoLastServedShow.get(root);
+            return show != null && show > reportOrder;
+        }
+    }
+
+    /** Records a window focus gain report of {@code root}, sent with start input sequence {@code startInputSeq}. */
+    @GuardedBy("mH")
+    private void noteDuoFocusReportLocked(int startInputSeq, @Nullable ViewRootImpl root) {
+        if (root == null || startInputSeq < 0) {
+            return;
+        }
+        mDuoFocusReports.put(startInputSeq, new DuoFocusReport(root, ++mDuoImeSeq));
+    }
+
+    /** Records a served show request of {@code root}. */
+    @GuardedBy("mH")
+    private void noteDuoServedShowLocked(@Nullable ViewRootImpl root) {
+        if (root != null) {
+            mDuoLastServedShow.put(root, ++mDuoImeSeq);
+        }
+    }
