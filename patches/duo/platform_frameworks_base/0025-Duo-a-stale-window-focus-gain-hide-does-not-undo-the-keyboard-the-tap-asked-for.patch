+    private static boolean skipDuoHide(@Nullable java.util.function.BooleanSupplier skipHide,
+            @NonNull ImeTracker.Token statsToken) {
+        if (skipHide == null || !skipHide.getAsBoolean()) {
+            return false;
+        }
