+    /**
+     * Duo two panel policy. A tap on an editor in a window that does not have window focus (the app on the other
+     * panel) is delivered, down and up, before the focus change it causes reaches the app: the window manager moves
+     * focus on the down, but the focus event arrives tens of milliseconds later. The editor takes view focus and asks
+     * for the keyboard while its window is not the current root, so the request is not served and was dropped; the
+     * window then gained focus with a focused editor, which shows nothing by itself (soft input state unspecified), and
+     * a keyboard shown for the previous window went away with its control. The user had to tap a second time. Remember
+     * such a request (only for the focused view of a window without window focus on the default display, the one with
+     * the panels, and only while the two panel policy is active) so {@link DelegateImpl#onPostWindowGainedFocus} can
+     * replay it once that window gains focus. A hide request in between drops it. The window can still be the current
+     * root (kept after it lost focus until the client is deactivated), so that is not a reason to ignore the request.
+     */
+    @GuardedBy("mH")
+    private void recordDuoPendingShowLocked(View view, @ShowFlags int flags) {
+        final ViewRootImpl viewRootImpl = view.getViewRootImpl();
+        if (viewRootImpl == null || viewRootImpl.getDisplayId() != Display.DEFAULT_DISPLAY
+                || view.hasWindowFocus() || !view.isFocused()
+                || !SystemProperties.getBoolean(DUO_PANELS_ACTIVE_PROP, false)) {
+            return;
+        }
+        mDuoPendingShowView = new WeakReference<>(view);
+        mDuoPendingShowFlags = flags;
+        mDuoPendingShowUptimeMs = SystemClock.uptimeMillis();
+    }
+
+    /**
+     * Returns the remembered show request if it was made by {@code focusedView}, the focused view of the window that
+     * has just gained focus, and is recent; clears it in any case (one replay, only for the next window focus gain).
+     */
+    @GuardedBy("mH")
+    @Nullable
+    private View takeDuoPendingShowLocked(View focusedView) {
+        final View view = mDuoPendingShowView != null ? mDuoPendingShowView.get() : null;
+        mDuoPendingShowView = null;
+        if (view == null || view != focusedView || !view.isFocused()
+                || view.getViewRootImpl() != mCurRootView
+                || SystemClock.uptimeMillis() - mDuoPendingShowUptimeMs > DUO_PENDING_SHOW_TIMEOUT_MS) {
+            return null;
+        }
+        return view;
+    }
+
