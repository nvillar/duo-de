# Files consumed by the Linux Android build must keep LF line endings,
# whatever the checkout platform or core.autocrlf setting.
# `git am` and bash fail or misbehave on CRLF input.

*.patch         text eol=lf
*.diff          text eol=lf
*.sh            text eol=lf
*.mk            text eol=lf
*.xml           text eol=lf
*.py            text eol=lf
*.bp            text eol=lf
*.java          text eol=lf
*.kt            text eol=lf
*.json          text eol=lf
*.te            text eol=lf
*.rc            text eol=lf
*.prop          text eol=lf
Containerfile   text eol=lf
Dockerfile      text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Binary assets.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.xcf           binary
*.img           binary
*.xz            binary
*.zip           binary
*.apk           binary
*.jar           binary
