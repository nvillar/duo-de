<?xml version="1.0" encoding="UTF-8"?>
<!--
  DUO-DE developer manifest: build/default.xml with every moving branch pinned
  to an exact commit. Used by dev/sync.sh together with build/remove.xml, on top
  of the AOSP manifest android-16.0.0_r4. Release builds (build.sh) still use
  build/default.xml.

  Differences from build/default.xml:
  - revision is a commit SHA; upstream records the branch it was resolved from.
  - The GApps project (vendor/gapps, Azure remote) is omitted; the developer flow
    builds only the vanilla variant. build/dev/pinned-gapps.xml adds it back.

  Resolved with `git ls-remote` on 2026-11-04 (UTC).
  These SHAs are NOT proven to be the inputs of release v2026.10.28
  (e68f56779723acb06bfdf11d9bc470d06554c5ba). Every tip below has a committer
  date before that release was created (2026-10-28T07:02Z), which is consistent
  with, but not proof of, the release having used the same commits.

  To refresh: run `git ls-remote https://github.com/<name> refs/heads/<upstream>`
  for each project, update revision, and the date above.
-->
<manifest>
  <remote name="github" fetch="https://github.com" />

  <!-- TrebleDroid -->
  <project path="device/phh/treble" name="TrebleDroid/device_phh_treble" remote="github" revision="ad694645eb591f00b3acced10b546397812435ec" upstream="android-16.0" />

  <!-- ponces -->
  <project path="packages/apps/ParanoidSense" name="Ethanol10/android_packages_apps_ParanoidSense" remote="github" revision="9ade12f91d85fa18d47b6e127ce46d43b05a80f6" upstream="beryl" />
