// DuoProbe: dev-only feasibility probe for the Surface Duo dual-panel work (milestone M1). See ../README.md.
// Never add this module to a release product. Public SDK only; no dependencies.
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "DuoProbe",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    privileged: false,
    // The manifest's optional <uses-library android:name="androidx.window.extensions"> is only used reflectively
    // (ExtensionsProbe); do not tie the build to that module existing in the product.
    enforce_uses_libs: false,
    optimize: {
        enabled: false,
    },
    dex_preopt: {
        enabled: false,
    },
}
